# ============================================================
# Plantilla de variables de entorno del backend (copia este
# archivo como .env y completa los valores). NUNCA subas el
# .env real a un repositorio.
# ============================================================

# Secreto para firmar los tokens de sesión JWT (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Puerto del servidor backend
PORT=3000

# URL del frontend (enlaces de recuperación de contraseña y callback OAuth)
FRONTEND_URL=http://localhost:5173

# ---- SMTP para correos de recuperación de contraseña ----
# Gmail requiere una "Contraseña de aplicación" creada en
# https://myaccount.google.com/apppasswords (con 2FA activado).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Panaderia <tu-correo@gmail.com>"

# ---- OAuth: Google (con openid-client) ----
# 1. https://console.cloud.google.com → crea un proyecto
# 2. APIs & Services → OAuth consent screen (External)
# 3. Credentials → Create OAuth client ID → Web application
# 4. Authorized redirect URIs (EXACTOS):
#    Desarrollo: http://localhost:3000/auth/google/callback
#    Producción: https://TU-DOMINIO/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el redirect URI registrado en Google Cloud.
# Desarrollo: http://localhost:3000/auth/google/callback
# Producción: https://TU-DOMINIO/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# URL del frontend React (Vite dev server)
FRONTEND_URL=http://localhost:5173

# ---- OAuth: Microsoft (Entra ID / Azure AD) ----
# 1. https://portal.azure.com → Microsoft Entra ID → App registrations → New
# 2. Authentication → Redirect URI:
#    http://localhost:3000/auth/oauth/microsoft/callback
# 3. Certificates & secrets → New client secret (copiar el "Value")
# 4. API permissions: openid, email, profile (User.Read)
# TENANT_ID: 'common' permite cuentas personales y de organizaciones.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- OAuth: Facebook ----
# 1. https://developers.facebook.com/apps → Create App (tipo Consumer)
# 2. Products → Facebook Login → Settings → Valid OAuth Redirect URIs:
#    http://localhost:3000/auth/oauth/facebook/callback
# 3. App ID y App Secret (Settings → Basic)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# URL base que el backend usa para construir el redirect_uri
# (el backend agrega /auth/oauth/<proveedor>/callback automáticamente)
OAUTH_REDIRECT_URI=http://localhost:3000

# Nota: un proveedor solo se activa si su CLIENT_ID y SECRET están
# definidos; el resto funciona con normalidad (contraseña local).
